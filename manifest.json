{
  "manifest_version": 3,
  "name": "Flow AI Video Generator",
  "version": "0.1.0",
  "description": "Generate prompt video batch via DeepSeek + image reference di Google Flow (labs.google/fx).",
  "permissions": [
    "storage",
    "downloads",
    "tabs",
    "debugger",
    "scripting",
    "sidePanel",
    "clipboardWrite",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://labs.google/*",
    "https://api.deepseek.com/*"
  ],
  "background": {
    "service_worker": "background/bg.js",
    "type": "module"
  },
  "action": {
    "default_title": "Flow AI Video Generator",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "panel/panel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://labs.google/fx/*"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
